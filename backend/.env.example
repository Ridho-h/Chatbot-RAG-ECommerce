# ══════════════════════════════════════════════════════════════════════
# Backend Environment Variables
# Copy this file to .env and fill in your values
# ══════════════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────────────
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── LLM ──────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
# OPENAI_API_KEY=your-openai-key-here  # Only if using openai provider
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0

# ── Web Search ───────────────────────────────────────────────────────
SEARCH_PROVIDER=duckduckgo
# SERPER_API_KEY=your-serper-key-here  # Only if using serper provider

# ── Vector Store (Pinecone) ──────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=ecommerce-bot

# ── Dataset (Kaggle) ─────────────────────────────────────────────────
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-256-bit-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# ── Rate Limiting ────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30

# ── Langfuse Tracing (optional) ─────────────────────────────────────
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# LANGFUSE_HOST=http://localhost:3001

# ── LangSmith Tracing (optional) ────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=ecommerce-chatbot
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com # Use https://apac.api.smith.langchain.com if your project is in APAC
